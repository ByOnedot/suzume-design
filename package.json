{
  "name": "@byonedot/web-react",
  "version": "1.0.1",
  "description": "Suzume Design - React and Next.js UI component library by byonedot.in.",
  "module": "./es/index.js",
  "main": "./lib/index.js",
  "unpkg": "./dist/suzume.min.js",
  "types": "./es/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run generate-version && pnpm run icon && pnpm run build",
    "prepack": "node ./scripts/sync-color-dep.js publish",
    "postpack": "node ./scripts/sync-color-dep.js dev",
    "start": "concurrently npm:dev",
    "build:dist": "node ./tools/build-scripts/lib/bin.js build:component:dist && pnpm run build:hooks:dist",
    "build:dist:dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider BUILD_ENV_MODE=development BUILD_ENV_DIST_FILENAME_JS=suzume.development.js node ./tools/build-scripts/lib/bin.js build:component:dist",
    "build:icon": "node ./tools/build-scripts/lib/bin.js build:icon",
    "build:es": "node ./tools/build-scripts/lib/bin.js build:component:es && pnpm run build:hooks:es",
    "build:cjs": "node ./tools/build-scripts/lib/bin.js build:component:cjs && pnpm run build:hooks:cjs",
    "build:css": "node ./tools/build-scripts/lib/bin.js build:component:css",
    "build:css:dev": "cross-env BUILD_ENV_MODE=development BUILD_ENV_DIST_FILENAME_CSS=suzume.css node ./tools/build-scripts/lib/bin.js build:component:css",
    "build:css:vars": "node ./scripts/css-variables.js",
    "build:hooks": "cd hooks && pnpm run build",
    "build:hooks:dist": "cd hooks && pnpm run build:dist",
    "build:hooks:cjs": "cd hooks && pnpm run build:cjs",
    "build:hooks:es": "cd hooks && pnpm run build:es",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider node ./tools/build-scripts/lib/bin.js build:component && pnpm run build:dist:dev && pnpm run build:css:dev && pnpm run build:hooks",
    "dev": "node ./tools/build-scripts/lib/bin.js dev:component",
    "eslint": "eslint tests components scripts",
    "stylelint": "stylelint \"components/**/*.less\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:client": "cross-env TZ=Asia/Singapore vitest run --config vitest.config.ts",
    "test:node": "cross-env TZ=Asia/Singapore vitest run --config vitest.node.config.ts",
    "test:watch": "cross-env TZ=Asia/Singapore vitest --config vitest.config.ts",
    "test": "cross-env TZ=Asia/Singapore vitest run --config vitest.config.ts && cross-env TZ=Asia/Singapore vitest run --config vitest.node.config.ts",
    "test:update-snapshots": "cross-env TZ=Asia/Singapore vitest run --config vitest.config.ts -u",
    "color": "node ./scripts/compileColors.js",
    "icon": "cd icon && rimraf react-icon/ && rimraf react-icon-cjs && cd build/ && node generate.js && node genDemo.js",
    "format": "prettier --config .prettierrc --write \"{stories,tests,components}/**/*.{js,jsx,ts,tsx}\"",
    "docgen": "node ./tools/build-scripts/lib/bin.js docgen",
    "docgen:hooks": "DOC_ENTRY=components/_hooks/* node ./tools/build-scripts/lib/bin.js docgen",
    "generate-version": "node ./scripts/generate-version.js",
    "check:branding": "node ./scripts/check-branding.js",
    "pack:check": "node ./scripts/pack-check.js",
    "release:bump": "node ./scripts/bump-version.js",
    "pre-commit": "pretty-quick --staged && npm run eslint && npm run stylelint",
    "check:links": "node ./scripts/check-links.js",
    "fix:doc-links": "node ./scripts/fix-doc-site-links.js",
    "replace:cdn-assets": "node ./scripts/replace-cdn-assets.js",
    "install:all": "pnpm install",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "visual:baseline": "cross-env SUZUME_CONSOLE_MODE=baseline playwright test",
    "coverage": "cross-env TZ=Asia/Singapore vitest run --config vitest.config.ts --coverage",
    "eslint:fix": "eslint tests components scripts --fix",
    "prepare": "husky install >/dev/null 2>&1 || true"
  },
  "keywords": [
    "suzume",
    "suzume-design",
    "SuzumeDesign",
    "react",
    "nextjs",
    "ui",
    "design-system",
    "component-library",
    "byonedot"
  ],
  "homepage": "https://byonedot.in",
  "author": "Suzume Design",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx-source": "^7.12.13",
    "@babel/plugin-transform-runtime": "^7.13.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash": "^4.14.173",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shallowequal": "^1.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-import": "^1.13.3",
    "chalk": "^4.1.2",
    "concurrently": "^5.2.0",
    "cross-env": "^7.0.3",
    "dnd-core": "^16.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^7.0.1",
    "glob": "^7.1.3",
    "globals": "^16.5.0",
    "husky": "^7.0.4",
    "jest-canvas-mock": "^2.5.2",
    "jsdom": "^30.1.1",
    "less": "^3.12.2",
    "moment": "^2.26.0",
    "moment-timezone": "^0.5.31",
    "npm-run-all": "^4.1.5",
    "nunjucks": "^3.2.2",
    "postcss-less": "4.0.1",
    "prettier": "^3.9.9",
    "pretty-quick": "^4.2.2",
    "react": "catalog:",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "catalog:",
    "react-draggable": "^4.4.5",
    "react-easy-crop": "^3.3.3",
    "react-resizable": "^3.0.0",
    "react-sortable-hoc": "^2.0.0",
    "rimraf": "^3.0.2",
    "sinon": "^9.0.1",
    "stylelint": "^14.1.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^24.0.0",
    "svgo": "^2.3.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "vite": "catalog:",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@babel/runtime": "^7.5.5",
    "@byonedot/color": "^1.0.1",
    "b-tween": "^0.3.3",
    "b-validate": "^1.4.2",
    "compute-scroll-into-view": "^1.0.17",
    "dayjs": "^1.10.5",
    "lodash": "^4.17.21",
    "number-precision": "^1.3.1",
    "react-focus-lock": "^2.13.2",
    "react-is": "^19.3.0",
    "react-transition-group": "^4.3.0",
    "resize-observer-polyfill": "^1.5.1",
    "scroll-into-view-if-needed": "^2.2.20",
    "shallowequal": "^1.1.0"
  },
  "sideEffects": [
    "dist/**/*",
    "es/**/style/*",
    "lib/**/style/*",
    "*.less"
  ],
  "files": [
    "dist",
    "es",
    "lib",
    "icon/react-icon",
    "icon/react-icon-cjs",
    "icon/index.js",
    "icon/index.es.js",
    "icon/index.d.ts",
    "icon/icons.json",
    "icon/package.json",
    "hooks/es",
    "hooks/lib",
    "hooks/package.json",
    "docs",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "_unpkg": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byonedot/suzume-design.git"
  },
  "bugs": {
    "url": "https://github.com/byonedot/suzume-design/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
