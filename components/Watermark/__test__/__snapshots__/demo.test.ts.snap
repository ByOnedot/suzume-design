// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders Watermark/demo/basic.md correctly 1`] = `"<div class="suzume-watermark"><div style="height:300px"></div></div>"`;

exports[`renders Watermark/demo/container.md correctly 1`] = `"<div class="suzume-row suzume-row-align-start suzume-row-justify-space-between"><div id="demo-watermark-1" style="width:400px;height:300px;line-height:300px;text-align:center;background:var(--color-primary-light-1)">Click to mount the watermark here</div><div id="demo-watermark-2" style="width:400px;height:300px;line-height:300px;text-align:center;background:var(--color-warning-light-1)">Click to mount the watermark here</div></div>"`;

exports[`renders Watermark/demo/contents.md correctly 1`] = `"<div class="suzume-watermark"><div style="height:300px"></div></div>"`;

exports[`renders Watermark/demo/image.md correctly 1`] = `"<div class="suzume-watermark"><div style="height:300px"></div></div>"`;

exports[`renders Watermark/demo/props.md correctly 1`] = `"<div style="color:var(--color-text-2);flex-wrap:nowrap" class="suzume-row suzume-row-align-start suzume-row-justify-start"><div class="suzume-watermark"><div><h2 class="suzume-typography">SuzumeDesign 的诞生</h2><span class="suzume-typography"><b>SuzumeDesign</b></span> 是一套设计系统的简称。<ul style="list-style-type:circle;padding-left:20px"><li>SuzumeDesign 的目标, 即通过通用的设计系统去解决产品中的体验问题, 并为产品设计提供指导原则解决业务问题，同时它能够促进设计部门和研发部门之间协作, 成为开发者之间沟通的语言。</li><li>SuzumeDesign 主要服务于字节跳动旗下中后台产品的体验设计和技术实现，主要由UED设计和开发同学共同构建及维护。</li></ul><h2 class="suzume-typography"> 设计语言 - 务实的浪漫主义</h2><img src="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27640%27%20height%3D%27360%27%3E%3Crect%20width%3D%27640%27%20height%3D%27360%27%20fill%3D%27%23722ED1%27%2F%3E%3Crect%20width%3D%27640%27%20height%3D%27140%27%20y%3D%27220%27%20fill%3D%27%2300000022%27%2F%3E%3C%2Fsvg%3E" width="600" style="z-index:50;position:relative"/><h3 class="suzume-typography"> SuzumeDesign试图建立一种工作模式</h3>务实=同理心 浪漫=想象力<ul style="list-style-type:circle;padding-left:20px"><li>首先在于务实能够通过设计系统去解决大部分需求极大提高效率解放双手。让设计师&amp;开发能去做一些更&quot;浪漫&quot;即发挥创新&amp;想象力的东西。</li><li>在产品侧我们不仅能够通过设计体系去务实的搭建基础功能，甚至可以通过它去配置一些能称得上浪漫的产品追求</li><li>浪漫与务实, 并非矛盾对立。通过对它们的定义得出设计语言的价值观, 这贯穿着整个设计语言。务实与浪漫相辅相成, 成为引导设计方向。</li></ul></div></div><form style="width:264px;flex-shrink:0;border-left:1px solid var(--color-border-2);padding-left:24px;margin-left:24px" class="suzume-form suzume-form-vertical suzume-form-size-default"><div class="suzume-row-align-start suzume-row-justify-start suzume-form-item suzume-form-layout-vertical"><div class="suzume-form-label-item"><label for="content_input"> 内容</label></div><div class="suzume-form-item-wrapper"><div class="suzume-form-item-control-wrapper"><div class="suzume-form-item-control" id="content"><div class="suzume-form-item-control-children"><input id="content_input" class="suzume-input suzume-input-size-default" value="Suzume Design"/></div></div></div></div></div><div class="suzume-row-align-start suzume-row-justify-start suzume-form-item suzume-form-layout-vertical"><div class="suzume-form-label-item"><label for="fontWeight_input"> 字重</label></div><div class="suzume-form-item-wrapper"><div class="suzume-form-item-control-wrapper"><div class="suzume-form-item-control" id="fontWeight"><div class="suzume-form-item-control-children"><div class="suzume-radio-group suzume-radio-size-default suzume-radio-mode-outline" role="radiogroup"><label class="suzume-radio"><input type="radio" value="lighter"/><span class="suzume-icon-hover suzume-radio-icon-hover suzume-radio-mask-wrapper"><div class="suzume-radio-mask"></div></span><span class="suzume-radio-text">lighter</span></label><label class="suzume-radio suzume-radio-checked"><input type="radio" checked="" value="normal"/><span class="suzume-icon-hover suzume-radio-icon-hover suzume-icon-hover-disabled suzume-radio-mask-wrapper"><div class="suzume-radio-mask"></div></span><span class="suzume-radio-text">normal</span></label><label class="suzume-radio"><input type="radio" value="bold"/><span class="suzume-icon-hover suzume-radio-icon-hover suzume-radio-mask-wrapper"><div class="suzume-radio-mask"></div></span><span class="suzume-radio-text">bold</span></label></div></div></div></div></div></div><div class="suzume-row-align-start suzume-row-justify-start suzume-form-item suzume-form-layout-vertical"><div class="suzume-form-label-item"><label for="fontFamily_input"> 字族</label></div><div class="suzume-form-item-wrapper"><div class="suzume-form-item-control-wrapper"><div class="suzume-form-item-control" id="fontFamily"><div class="suzume-form-item-control-children"><div class="suzume-radio-group suzume-radio-size-default suzume-radio-mode-outline" role="radiogroup"><label class="suzume-radio suzume-radio-checked"><input type="radio" checked="" value="sans-serif"/><span class="suzume-icon-hover suzume-radio-icon-hover suzume-icon-hover-disabled suzume-radio-mask-wrapper"><div class="suzume-radio-mask"></div></span><span class="suzume-radio-text">sans-serif</span></label><label class="suzume-radio"><input type="radio" value="serif"/><span class="suzume-icon-hover suzume-radio-icon-hover suzume-radio-mask-wrapper"><div class="suzume-radio-mask"></div></span><span class="suzume-radio-text">serif</span></label></div></div></div></div></div></div><div class="suzume-row-align-start suzume-row-justify-start suzume-form-item suzume-form-layout-vertical"><div class="suzume-form-label-item"><label for="color_input"> 颜色</label></div><div class="suzume-form-item-wrapper"><div class="suzume-form-item-control-wrapper"><div class="suzume-form-item-control" id="color"><div class="suzume-form-item-control-children"><div class="suzume-color-picker suzume-color-picker-size-default"><div class="suzume-color-picker-preview" style="background-color:rgba(0,0,0,0.12)"></div><div class="suzume-color-picker-value">rgba(0,0,0,0.12)</div><input class="suzume-color-picker-input" readOnly="" value="rgba(0,0,0,0.12)"/></div></div></div></div></div></div><div class="suzume-row-align-start suzume-row-justify-start suzume-form-item suzume-form-layout-vertical"><div class="suzume-form-label-item"><label for="fontSize_input"> 字体大小</label></div><div class="suzume-form-item-wrapper"><div class="suzume-form-item-control-wrapper"><div class="suzume-form-item-control" id="fontSize"><div class="suzume-form-item-control-children"><div id="fontSize_input" class="suzume-slider"><div class="suzume-slider-wrapper"><div class="suzume-slider-road"><div class="suzume-slider-bar" style="left:0%;right:95.45454545454545%"></div><div class="suzume-slider-button" style="left:4.545454545454546%" role="slider" aria-valuemax="100" aria-valuemin="12" aria-valuenow="16" aria-disabled="false" tabindex="0" aria-valuetext="16"></div></div></div></div></div></div></div></div></div><div class="suzume-row-align-start suzume-row-justify-start suzume-form-item suzume-form-layout-vertical"><div class="suzume-form-label-item"><label for="rotate_input"> 旋转角度</label></div><div class="suzume-form-item-wrapper"><div class="suzume-form-item-control-wrapper"><div class="suzume-form-item-control" id="rotate"><div class="suzume-form-item-control-children"><div id="rotate_input" class="suzume-slider"><div class="suzume-slider-wrapper"><div class="suzume-slider-road"><div class="suzume-slider-bar" style="left:0%;right:41.666666666666664%"></div><div class="suzume-slider-button" style="left:58.333333333333336%" role="slider" aria-valuemax="180" aria-valuemin="-180" aria-valuenow="30" aria-disabled="false" tabindex="0" aria-valuetext="30"></div></div></div></div></div></div></div></div></div><div class="suzume-row-align-start suzume-row-justify-start suzume-form-item suzume-form-layout-vertical"><div class="suzume-form-label-item"><label for="zIndex_input"> zIndex</label></div><div class="suzume-form-item-wrapper"><div class="suzume-form-item-control-wrapper"><div class="suzume-form-item-control" id="zIndex"><div class="suzume-form-item-control-children"><div id="zIndex_input" class="suzume-slider"><div class="suzume-slider-wrapper"><div class="suzume-slider-road"><div class="suzume-slider-bar" style="left:0%;right:98.01980198019803%"></div><div class="suzume-slider-button" style="left:1.98019801980198%" role="slider" aria-valuemax="100" aria-valuemin="-1" aria-valuenow="1" aria-disabled="false" tabindex="0" aria-valuetext="1"></div></div></div></div></div></div></div></div></div><div class="suzume-row-align-start suzume-row-justify-start suzume-form-item suzume-form-layout-vertical"><div class="suzume-form-label-item"><label> 间距</label></div><div class="suzume-form-item-wrapper"><div class="suzume-form-item-control-wrapper"><div class="suzume-form-item-control"><div class="suzume-form-item-control-children"><div class="suzume-space suzume-space-horizontal suzume-space-align-center"><div class="suzume-space-item" style="margin-right:8px"><div class="suzume-input-group-wrapper suzume-input-group-wrapper-default suzume-input-has-suffix suzume-input-number suzume-input-number-mode-embed suzume-input-number-size-default"><span class="suzume-input-group"><span class="suzume-input-inner-wrapper suzume-input-inner-wrapper-default"><input role="spinbutton" aria-valuemax="Infinity" aria-valuemin="-Infinity" aria-valuenow="100" id="gapsX_input" placeholder="水平间距" class="suzume-input suzume-input-size-default" value="100"/><span class="suzume-input-group-suffix"><div class="suzume-input-number-step-layer"><div class="suzume-input-number-step-button"><svg fill="none" stroke="currentColor" stroke-width="4" viewBox="0 0 48 48" aria-hidden="true" focusable="false" class="suzume-icon suzume-icon-up"><path d="M39.6 30.557 24.043 15 8.487 30.557"></path></svg></div><div class="suzume-input-number-step-button"><svg fill="none" stroke="currentColor" stroke-width="4" viewBox="0 0 48 48" aria-hidden="true" focusable="false" class="suzume-icon suzume-icon-down"><path d="M39.6 17.443 24.043 33 8.487 17.443"></path></svg></div></div></span></span></span></div></div><div class="suzume-space-item"><div class="suzume-input-group-wrapper suzume-input-group-wrapper-default suzume-input-has-suffix suzume-input-number suzume-input-number-mode-embed suzume-input-number-size-default"><span class="suzume-input-group"><span class="suzume-input-inner-wrapper suzume-input-inner-wrapper-default"><input role="spinbutton" aria-valuemax="Infinity" aria-valuemin="-Infinity" aria-valuenow="100" id="gapsY_input" placeholder="竖直间距" class="suzume-input suzume-input-size-default" value="100"/><span class="suzume-input-group-suffix"><div class="suzume-input-number-step-layer"><div class="suzume-input-number-step-button"><svg fill="none" stroke="currentColor" stroke-width="4" viewBox="0 0 48 48" aria-hidden="true" focusable="false" class="suzume-icon suzume-icon-up"><path d="M39.6 30.557 24.043 15 8.487 30.557"></path></svg></div><div class="suzume-input-number-step